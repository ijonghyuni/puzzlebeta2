# Unity WebGL Brotli-compressed build files.
# Cloudflare Pages reads this file from the deployment output directory.
/Build/*.data.br
  Content-Encoding: br
  Content-Type: application/octet-stream

/Build/*.framework.js.br
  Content-Encoding: br
  Content-Type: application/javascript

/Build/*.wasm.br
  Content-Encoding: br
  Content-Type: application/wasm

/Build/*.symbols.json.br
  Content-Encoding: br
  Content-Type: application/octet-stream
